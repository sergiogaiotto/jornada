# .env.example — SDD §3.1 (copiar para .env; NUNCA commitar .env com segredos reais)
# Formato real: uma variável por linha (o SDD compacta algumas linhas por legibilidade).
#
# ===========================================================================
# COMO LER ESTE ARQUIVO
# ===========================================================================
# Cada variável traz, quando não é óbvio, três informações: o DEFAULT do código
# (backend/app/config.py — o que vale se a variável não existir), o QUE QUEBRA sem ela e
# se é SEGREDO. Marcas usadas:
#
#   [SEGREDO]   nunca preencher aqui; injetar por ambiente/vault na hora de subir.
#   [PROD]      precisa de valor PRÓPRIO em produção — o default é de dev e não serve.
#   [SEM USO]   a variável existe no config mas NENHUM código a lê hoje. Fica listada
#               porque some do inventário quem não a vê; ver a nota no fim do arquivo.
#
# ATENÇÃO — REGRA DO ARQUIVO (achado da onda 2, e o motivo de ele ter virado regra):
# o parser de `.env` só trata `# ...` como comentário quando a linha TEM valor. Em
# variável VAZIA o texto do comentário vira o VALOR. Comentário de variável vazia vai
# SEMPRE na linha ACIMA, nunca ao lado. Há teste que lê este arquivo de verdade
# (backend/tests/unit/test_G01_senha_e_identidade.py e o guarda-corpo genérico em
# backend/tests/acceptance/test_prod_corte_de_ambiente.py).
#
# ===========================================================================
# O CORTE DE AMBIENTE — o que muda de dev para prod (§10.3)
# ===========================================================================
# Ligar `APP_ENV=prod` muda TRÊS comportamentos, e é para isso que ele serve:
#   1. os tokens estáticos `dev-<papel>`/`portal-dev` deixam de valer (app/auth.py
#      `tokens_dev_ativos`) — e a config nem carrega com `PERMITIR_TOKENS_DEV=true`;
#   2. as seeds DEMO_MODE (OS-2026-0457, §11.4) NÃO carregam, mesmo com DEMO_MODE=true
#      (app/main.py: `settings.demo_mode and settings.app_env == "dev"`);
#   3. `APP_SECRET` igual ao default derruba o startup.
# O inverso também é verdade e é o risco a lembrar: com `APP_ENV=dev` num host público,
# `Authorization: Bearer dev-admin` — seis strings publicadas neste repositório — é
# credencial de administrador válida.

# --- App ---
APP_ENV=dev                      # dev|homolog|prod
# [SEGREDO][PROD] HMAC do webhook de lançamento (api/v1/lancamento.py). Em APP_ENV=prod
# o valor `change-me` FAZ O STARTUP FALHAR (§10.3). Gerar com `openssl rand -hex 32`.
APP_SECRET=change-me
APP_BASE_URL=http://localhost:8000    # [SEM USO] nenhum código lê `settings.app_base_url`
# [PROD] Base pública do FRONT — é o que vai dentro do link mágico de aprovação
# (api/v1/portoes.py). Errada aqui = aprovador recebe link que não abre.
WEB_BASE_URL=http://localhost:5173
DEFAULT_TENANT=torre-movel       # tenant das seeds do Ateliê/políticas e do root

# --- Banco ---
# [SEGREDO][PROD] carrega a senha do Postgres. Lida por DOIS caminhos: `os.environ`
# em app/main.py (escolhe repos SQL × memória) e `settings.database_url` no ping do
# /healthz. AUSENTE não quebra o boot — é pior: a aplicação sobe em MEMÓRIA e todo o
# dado morre no restart, com /healthz ainda respondendo `db: ok` contra o default.
DATABASE_URL=postgresql+asyncpg://jornada:jornada@db:5432/jornada

# --- Identidade & sessão (emenda G01 — usuários locais com senha, §8-M0) ---
SESSION_COOKIE_NOME=jornada_sessao
# [PROD] HTTP puro hoje; virar `true` JUNTO com o TLS — antes do TLS o navegador não
# envia o cookie e o login some; depois do TLS, `false` deixa a sessão viajar em claro.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HORAS=12
LOGIN_MAX_TENTATIVAS=5           # falhas consecutivas antes do bloqueio temporal
LOGIN_BLOQUEIO_MINUTOS=15
PERMITIR_TOKENS_DEV=false        # tokens estáticos dev-<papel>/portal-dev fora de dev;
                                 # APP_ENV=prod + true → startup FALHA (§10.3)

# Bootstrap do root: cria a conta admin no 1º acesso SE ela ainda não existir.
# Idempotente — rodar de novo NÃO reseta a senha de quem já trocou.
# JORNADA_ROOT_SENHA é SEGREDO: injetar por ambiente/vault na hora de subir.
# NUNCA preencher com valor real neste arquivo (ele é versionado).
#
# ATENÇÃO — os dois abaixo ficam VAZIOS e SEM comentário na mesma linha: quando o valor
# é vazio, o parser de .env NÃO trata `# ...` como comentário e adota o texto do
# comentário COMO VALOR. Com `JORNADA_ROOT_EMAIL=  # login do root` este arquivo criava
# um admin cujo login E senha eram estas duas frases — publicadas aqui — para todo mundo
# que seguisse a instrução da linha 1 ("copiar para .env"). Comentário de variável vazia
# vai ACIMA da chave, nunca ao lado.
# JORNADA_ROOT_EMAIL: login do root (aceita identificador sem @, e sem espaços).
# JORNADA_ROOT_SENHA: ≥12 caracteres; a conta nasce expirada (troca no 1º acesso).
# Vazios os dois: o boot segue normal e NENHUM root é criado — a aplicação não quebra
# por isso, mas num tenant novo não haverá ninguém para entrar.
JORNADA_ROOT_EMAIL=
JORNADA_ROOT_SENHA=

# [SEGREDO] Credencial de MÁQUINA do purge de retenção §10.4 (F04). NÃO está em
# `config.py`: é lida direto de `os.environ` por api/v1/admin.py, e vale só na rota do
# purge. Piso de 32 caracteres — abaixo disso é tratada como AUSENTE (fail-closed).
# VAZIA = porta FECHADA (o purge volta a exigir dpo/admin humano), nunca aberta.
# Gerar no servidor com `openssl rand -hex 32`; quem escreve é deploy/deploy.sh.
JORNADA_PURGE_TOKEN=

# --- LLM HubGPU (OpenAI-compatible) ---
LLM_120B_BASE_URL=https://hub-gpus.claro.com.br/gpt120/v1
LLM_120B_MODEL=openai/gpt-oss-120b
LLM_20B_BASE_URL=https://hub-gpus.claro.com.br/gpt20/v1
LLM_20B_MODEL=openai/gpt-oss-20b
LLM_API_KEY=not-needed           # §3: literal válido — o proxy do hub autentica por outra via
LLM_TIMEOUT_S=300                # default 300s (config do hub)
LLM_MAX_RETRIES=2
LLM_DEGRADED_MODE=auto           # auto|forced_off — §10.6 (fila + modo manual)

# --- Embeddings (Qwen3 via hub interno; reusa scheme://host do OSS-120B se path relativo) ---
EMBED_BASE_URL=https://hub-gpus.claro.com.br/embed06b/v1
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIM=1024                   # padrão do modelo; mudar exige re-embed da collection (§10.4)
EMBED_TIMEOUT_S=30               # emenda A11: timeout próprio (curto) do POST /embeddings
RAG_COLLECTION=agente_evidence   # [SEM USO] o nome da collection está no código, não aqui

# --- SFMC (dev aponta para o mock) ---
# [PROD] os quatro endpoints e as credenciais têm de sair do mock — apontar para o
# tenant SFMC real. CLIENT_SECRET é [SEGREDO].
SFMC_AUTH_URL=http://mock-sfmc:8080/v2/token
SFMC_REST_URL=http://mock-sfmc:8080/rest
SFMC_SOAP_URL=http://mock-sfmc:8080/soap
SFMC_CLIENT_ID=mock
SFMC_CLIENT_SECRET=mock
SFMC_ACCOUNT_MID=mock
SFMC_API_BUDGET_PER_APPLY=200    # orçamento de chamadas por apply

# --- Data Cloud (dev aponta para o mock) ---
# [PROD] idem SFMC. DC_CLIENT_SECRET é [SEGREDO].
DC_AUTH_URL=http://mock-datacloud:8081/oauth/token
DC_API_URL=http://mock-datacloud:8081/api/v2
DC_CLIENT_ID=mock
DC_CLIENT_SECRET=mock

# --- Notificações / dev ---
SMTP_URL=smtp://mailpit:1025     # [SEM USO] nunca teve consumidor (ver nota no fim)
# [SEM USO] nenhum código lê `settings.teams_webhook_url`. Fica VAZIA e sem comentário
# ao lado, pela regra do topo deste arquivo.
TEAMS_WEBHOOK_URL=
DEMO_MODE=true                   # carrega as seeds OS-2026-0457 (§11.4) — e SÓ em
                                 # APP_ENV=dev: em prod é ignorada, por desenho

# --- Observabilidade (Langfuse self-hosted — §10.8) ---
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-dev    # [PROD] par gerado no projeto Langfuse do servidor
LANGFUSE_SECRET_KEY=sk-lf-dev    # [SEGREDO][PROD] idem
LANGFUSE_ENABLED=true            # false → no-op (app nunca depende do Langfuse)

# ===========================================================================
# NÃO ESTÃO NO `config.py` — mas o processo/compose as usa
# ===========================================================================
# GIT_SHA ................ carimbo de versão da imagem (ARG/ENV no Dockerfile); sai em
#                          GET /healthz.sha e é o que o smoke pós-deploy compara.
#                          Ausente → "dev". Não pertence ao `.env` da aplicação.
# Só no docker-compose.prod.yml (serviços de infra, não lidos pelo backend):
#   JORNADA_DB_PASSWORD [SEGREDO] · LANGFUSE_PK · LANGFUSE_SK [SEGREDO] ·
#   LANGFUSE_DB_PASSWORD [SEGREDO] · LANGFUSE_NEXTAUTH_SECRET [SEGREDO] ·
#   LANGFUSE_SALT [SEGREDO] · LANGFUSE_INIT_EMAIL · LANGFUSE_INIT_PASSWORD [SEGREDO] ·
#   LANGFUSE_PUBLIC_URL
#
# SOBRE AS `[SEM USO]` (APP_BASE_URL, RAG_COLLECTION, SMTP_URL, TEAMS_WEBHOOK_URL):
# ficam documentadas em vez de apagadas porque o §3.1 do SDD as lista e removê-las do
# exemplo sem emendar o contrato só as tornaria invisíveis — configuração que ninguém lê
# é a que ninguém confere. Elas não têm efeito nenhum hoje: preencher `SMTP_URL` não
# manda e-mail, preencher `TEAMS_WEBHOOK_URL` não notifica ninguém. EMENDA SUGERIDA:
# decidir por variável entre implementar o consumidor ou tirá-la do §3.1 e do `config.py`.
